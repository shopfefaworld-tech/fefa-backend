PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/fefa

# JWT
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_refresh

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@fefajewelry.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_SECURE=false
EMAIL_FROM=noreply@fefajewelry.com
EMAIL_FROM_NAME=FEFA Jewelry

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# Firebase Web (optional, if needed client-side)
FIREBASE_WEB_API_KEY=

# Shipping Provider
# Use 'delhivery' for your live setup. Options: delhivery | bluedart | manual
SHIPPING_PROVIDER=delhivery
# Automatically create a shipment after successful payment
AUTO_CREATE_SHIPMENT=true
# Default pickup pincode for your warehouse (replace with your real pincode)
SHIPPING_PICKUP_PINCODE=500000
SHIPPING_WEBHOOK_SECRET=

# Blue Dart API
BLUEDART_API_BASE_URL=
BLUEDART_AUTH_TYPE=basic
BLUEDART_API_KEY=
BLUEDART_API_SECRET=
BLUEDART_USERNAME=
BLUEDART_PASSWORD=
BLUEDART_ACCOUNT_CODE=
BLUEDART_CUSTOMER_CODE=
BLUEDART_TRACKING_URL_TEMPLATE=https://www.bluedart.com/tracking?awb={awb}
BLUEDART_TIMEOUT_MS=15000
BLUEDART_MAX_RETRIES=1

# Optional endpoint overrides (depends on your Blue Dart integration package/protocol)
BLUEDART_ENDPOINT_SERVICEABILITY=
BLUEDART_ENDPOINT_CREATE_SHIPMENT=
BLUEDART_ENDPOINT_GENERATE_LABEL=
BLUEDART_ENDPOINT_REQUEST_PICKUP=
BLUEDART_ENDPOINT_TRACK=
BLUEDART_ENDPOINT_CANCEL_SHIPMENT=
BLUEDART_ENDPOINT_RETURN_PICKUP=
BLUEDART_ENDPOINT_PICKUP_LOCATIONS=

# Delhivery API
# Base URL for Delhivery Last-Mile APIs
# Staging:    https://staging-express.delhivery.com
# Production: https://track.delhivery.com
DELHIVERY_API_BASE_URL=https://track.delhivery.com
# Auth type for Delhivery. Defaults to \"token\" which sends Authorization: Token <DELHIVERY_API_KEY>
DELHIVERY_AUTH_TYPE=token
# API token generated from Delhivery One portal (DO NOT COMMIT REAL VALUE)
DELHIVERY_API_KEY=your_delhivery_api_token_here
# Optional: override timeouts / retries
DELHIVERY_TIMEOUT_MS=15000
DELHIVERY_MAX_RETRIES=1
# Optional tracking URL template if Delhivery doesn't return one directly
DELHIVERY_TRACKING_URL_TEMPLATE=https://track.delhivery.com/tracking?waybill={awb}
# Name of the Delhivery pickup location (must exactly match WH name in Delhivery One)
DELHIVERY_PICKUP_LOCATION_NAME=Dhaatri Nilayam, Bhoomi Reddy Road, Rajesh Reddy Nagar, Hastinapuram, Hyderabad, 500079
# Optional endpoint overrides (use if Delhivery changes paths or you prefer explicit URLs)
DELHIVERY_ENDPOINT_SERVICEABILITY=
DELHIVERY_ENDPOINT_CREATE_SHIPMENT=
DELHIVERY_ENDPOINT_GENERATE_LABEL=
DELHIVERY_ENDPOINT_REQUEST_PICKUP=
DELHIVERY_ENDPOINT_TRACK=
DELHIVERY_ENDPOINT_CANCEL_SHIPMENT=
DELHIVERY_ENDPOINT_RETURN_PICKUP=
DELHIVERY_ENDPOINT_PICKUP_LOCATIONS=